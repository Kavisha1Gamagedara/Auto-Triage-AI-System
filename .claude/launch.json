    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5183", "--strictPort", "--mode", "altport"],
      "port": 5183
    }
  ]
}
