{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-X", "utf8", "-m", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8010"],
      "port": 8010
