# Environment Configuration for Auto-Triage AI System

# Groq API Configuration (Required for Agent 2 Diagnostic Reasoning)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default used by Agent 2)
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Configuration (Required for Agent 4 Procurement & Pricing)
# Local default, or an Atlas SRV string: mongodb+srv://<user>:<password>@<cluster>/
MONGO_URI=mongodb://localhost:27017
MONGO_DB=auto_triage
